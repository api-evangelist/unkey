{
  "operationId": "identities.getIdentity",
  "method": "POST",
  "path": "/v2/identities.getIdentity",
  "summary": "Get Identity",
  "requestExamples": [
    {
      "contentType": "application/json",
      "name": "basic",
      "example": {
        "identity": "user_123"
      }
    }
  ],
  "responseExamples": [
