{
  "operationId": "ratelimit.limit",
  "method": "POST",
  "path": "/v2/ratelimit.limit",
  "summary": "Apply Rate Limiting",
  "requestExamples": [
    {
      "contentType": "application/json",
      "name": "basic",
      "example": {
        "duration": 60000,
        "identifier": "user_abc123",
        "limit": 100,
        "namespace": "api.requests"
      }
    },
    {
