        "data": {
          "externalId": "user_123",
          "id": "id_1234567890abcdef",
          "meta": {
            "email": "alice@example.com",
            "name": "Alice Smith",
            "plan": "premium"
          },
          "ratelimits": [
            {
              "duration": 60000,
